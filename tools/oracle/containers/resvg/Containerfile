# resvg as a pixel oracle for the conformance harness.
#
# Built here: two builds of one Containerfile are not two copies of one image,
# so everything the build reads is pinned (base by digest, packages by full
# apt version against a dated Debian snapshot) and the run-time version check
# in oracle_env.py is the real guarantee. Installed from the distribution's
# package: no source is read and none is built.
FROM docker.io/library/debian@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c

ARG SNAPSHOT=20260918T000000Z

RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends resvg=0.45.1-1 \
    && rm -rf /var/lib/apt/lists/*

# A probe script rather than a shell one-liner: a quoting layer between a check
# and the fact it checks is how a probe passes while reading the wrong line.
COPY resvg-version /usr/local/bin/resvg-version
RUN chmod 0755 /usr/local/bin/resvg-version

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

ENTRYPOINT []
CMD ["resvg-version"]
